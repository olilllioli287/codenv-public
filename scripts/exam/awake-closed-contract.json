{
  "C380": {
    "name": "闔蓋中斷後保持醒著、風扇交回系統",
    "simulation": {
      "lid": [
        "close"
      ],
      "sessions": [
        "working-terminable"
      ],
      "external": false
    },
    "expected": {
      "state": "awakeClosed",
      "terminatedCount": 1,
      "nosleepOn": true,
      "sleepNowCount": 0,
      "setFanAutoCount": 1
    }
  },
  "C381": {
    "name": "闔蓋時沒有工作交回系統睡眠",
    "simulation": {
      "scenarios": [
        {
          "id": "preheldNoWork",
          "lid": [
            "close"
          ],
          "sessions": [],
          "preheld": true
        },
        {
          "id": "workInterrupted",
          "lid": [
            "close"
          ],
          "sessions": [
            "working-terminable"
          ]
        }
      ]
    },
    "expected": {
      "preheldNoWork": {
        "state": "open",
        "nosleepOffCount": 1,
        "sleepNowCount": 1
      },
      "workInterrupted": {
        "state": "awakeClosed",
        "sleepNowCount": 0
      }
    }
  },
  "C382": {
    "name": "滿 30 分鐘單調計時後睡眠",
    "simulation": {
      "lid": [
        "close",
        "continuous+1800"
      ],
      "wallClockJumps": [
        7200,
        -3600
      ],
      "sessions": [
        "working-terminable"
      ]
    },
    "expected": {
      "sleepNowCount": 1,
      "sleptByAwakeClosed": true,
      "sleepNowElapsedSecondsFromAwakeClosedEntry": 1800
    }
  },
  "C383": {
    "name": "低於 20% 且未插電立刻睡",
    "simulation": {
      "lid": [
        "close"
      ],
      "sessions": [
        "working-terminable"
      ],
      "battery": 19,
      "onAC": false
    },
    "expected": {
      "sleepNowCount": 1,
      "sleepReason": "lowBattery",
      "sleepNowElapsedSecondsFromAwakeClosedEntry": 0
    }
  },
  "C384": {
    "name": "低電量插電不立即睡",
