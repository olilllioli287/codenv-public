  "C392": {
    "name": "遠端連線暫停計時、斷線後重計三十分鐘",
    "simulation": {
      "lid": [
        "close",
        "remote=1",
        "continuous+2400",
        "remote=0",
        "continuous+1799",
        "continuous+1"
      ],
      "sessions": [
        "working-terminable"
      ],
      "remote": [
        false,
        true,
        true,
        false,
        false,
        false
      ]
    },
    "expected": {
      "sleepBeforeDisconnect": false,
      "sleepAfterRestarted30m": true,
      "awakeClosedSinceReset": true
    }
  },
  "C393": {
    "name": "遠端期間低電量與過熱保護仍睡",
    "simulation": {
      "scenarios": [
        {
          "id": "lowBatteryDuringRemote",
          "lid": [
            "close",
            "remote=1"
          ],
          "sessions": [
            "working-terminable"
          ],
          "battery": 10,
          "onAC": false
        },
        {
          "id": "overheatDuringRemote",
          "lid": [
            "close",
            "remote=1",
            "temperature=95",
            "continuous+60"
          ],
          "sessions": [
            "working-terminable"
          ],
          "battery": 80,
          "onAC": false,
          "temperatureSequence": [
            95
          ]
        }
      ]
    },
    "expected": {
      "lowBatteryDuringRemote": {
        "sleepNowCount": 1,
        "sleepReason": "lowBattery",
        "sleepNowElapsedSecondsFromAwakeClosedEntry": 0
      },
      "overheatDuringRemote": {
        "sleepNowCount": 1,
        "sleepReason": "overheat",
        "sleepNowElapsedSecondsFromAwakeClosedEntry": 60
      }
    }
  },
