  "C386": {
    "name": "開蓋自動繼續只送被中斷者一次",
    "simulation": {
      "lid": [
        "close",
        "open<1800"
      ],
      "sessions": [
        "terminated-foreground",
        "idle"
      ],
      "queue": [
        {
          "session": "terminated-foreground",
          "text": "QUEUE_RESUME_TEXT",
          "image": false
        }
      ]
    },
    "expected": {
      "resumeById": {
        "terminated-foreground": 1,
        "idle": 0
      },
      "noticeById": {
        "terminated-foreground": 0
      },
      "resumeContainsSafetyText": true,
      "resumeContainsOriginalQueueText": true,
      "queuePendingClearedAfterSuccess": true
    }
  },
  "C387": {
