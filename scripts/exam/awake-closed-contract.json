  "C399": {
    "name": "開蓋三秒內重闔不混合週期記錄",
    "simulation": {
      "lid": [
        "close(A)",
        "open@1",
        "close@2(B)",
        "open@5"
      ],
      "sessions": [
        "A",
        "B"
      ],
      "queue": [
        {
          "session": "A",
          "text": "QUEUE_CYCLE_A"
        },
        {
          "session": "B",
          "text": "QUEUE_CYCLE_B"
        }
      ]
    },
    "expected": {
      "recordsByCycle": [
        {
          "A": 1,
          "B": 0
        },
        {
          "A": 0,
          "B": 1
        }
      ],
      "resumeById": {
        "A": 1,
        "B": 1
      },
      "queueContentPreservedByCycle": {
        "A": true,
        "B": true
      }
    }
  },
