#!/usr/bin/env python3
"""codenv 瀏覽器格子：讀格子裡的網頁內容（只能讀，不能點、不能打字）。

  codenv-browser ls                    列出開著的瀏覽器格子（id、側欄名稱、網頁標題、網址）
  codenv-browser url  [格子]           網址和標題
  codenv-browser text [格子] [--max N] 網頁上看得到的文字（預設最多 10 萬字）
  codenv-browser shot [格子] [-o 檔案.png]   目前看得到的範圍截圖（預設存到暫存資料夾，印出路徑）
  codenv-browser export [格子] [--out 資料夾]  把 Gemini 網頁（gemini.google.com）的整段對話匯成 Markdown＋圖片：
                                       在「資料夾」（預設 ~/Downloads）底下建 <對話標題>-<時間>/，裡面 chat.md＋assets/；同名不覆蓋。
                                       第一行印資料夾路徑，第二行是輪數和圖片數。舊訊息要先捲上去載入，長對話可能要一兩分鐘。只讀網頁。

[格子]：id 開頭幾個字、側欄名稱，或標題裡的字；不寫＝最近點過的那格。
codenv 要開著。通道是 codenv 開的 Unix socket（不開網路埠），token 每次啟動會換；
位置在 ~/Library/Application Support/codenv/browser/，CODENV_BROWSER_DIR 可以改（測試用）。
"""
import base64, json, os, socket, sys, tempfile, time

DIR = os.environ.get("CODENV_BROWSER_DIR") or os.path.expanduser("~/Library/Application Support/codenv/browser")


def die(msg):
    print(msg, file=sys.stderr)
    sys.exit(1)


def ask(req, timeout=30):
    if os.environ.get("CODENV_SCOPED_TOKEN") and os.environ.get("CODENV_SOCKET"):
        token, path = os.environ["CODENV_SCOPED_TOKEN"], os.environ["CODENV_SOCKET"]      # 沙盒聊天室：專屬 token（讀不到 AI 工作台資料夾）
    else:
      try:
        token = open(os.path.join(DIR, "token")).read().strip()
        path = open(os.path.join(DIR, "socket")).read().strip()
      except OSError:
        die("找不到 codenv 的瀏覽器通道：codenv 沒開，或還沒更新到有瀏覽器格子的版本")
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(timeout)
    try:
        s.connect(path)
    except OSError:
        die("連不上 codenv（可能剛關掉）：重開 codenv 再試")
    req["token"] = token
    data = b""
    try:
        s.sendall((json.dumps(req) + "\n").encode())
        while True:
            chunk = s.recv(1 << 16)
            if not chunk:
                break
            data += chunk
    except socket.timeout:
        die("codenv %d 秒都沒回應（可能卡住了），再試一次" % timeout)
    except OSError as e:
        die("跟 codenv 的連線中斷了：%s" % e)
    finally:
        s.close()
    try:
        r = json.loads(data.decode())
    except ValueError:
        die("codenv 回了看不懂的東西")
    if not r.get("ok"):
        die(r.get("error") or "失敗")
    return r


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return
    cmd, rest = argv[0], argv[1:]
    opts, pos = {}, []
    i = 0
    while i < len(rest):
        if rest[i] in ("--max", "-o", "--out") and i + 1 < len(rest):
            opts[rest[i]] = rest[i + 1]
            i += 2
        else:
            pos.append(rest[i])
            i += 1
    pane = " ".join(pos)

    # 網頁的字直接印到終端機：控制字元（OSC 52 改剪貼簿、清畫面、偽造輸出之類）全部換成可見的符號。
    # 內文留換行和 tab；標題、網址、名稱這種單行欄位連換行也換掉，免得偽造出多行（Codex 11/6：ls、url 原本沒過濾）
    def safe(t, keep="\n\t"):
        return "".join(c if c in keep or (c >= " " and c != "\x7f" and not ("\x80" <= c <= "\x9f")) else "\ufffd" for c in str(t))

    def one(t):
        return safe(t, keep="")

    if cmd == "ls":
        r = ask({"cmd": "ls"})
        if not r["panes"]:
            print("（沒有開著的瀏覽器格子）")
        for p in r["panes"]:
            print(f'{one(p["id"])}  {one(p["name"])}｜{one(p["title"])}\n          {one(p["url"])}')
    elif cmd == "url":
        r = ask({"cmd": "url", "pane": pane})
        print(f'{one(r["title"])}\n{one(r["url"])}')
    elif cmd == "text":
        req = {"cmd": "text", "pane": pane}
        if "--max" in opts:
            try:
                req["max"] = int(opts["--max"])
            except ValueError:
                die("--max 要是數字")
        r = ask(req)
        print(f'# {one(r["title"])}\n# {one(r["url"])}\n')
        print(safe(r["text"]))
    elif cmd == "shot":
        r = ask({"cmd": "shot", "pane": pane})
        png = base64.b64decode(r["png"])
        if opts.get("-o"):
            out = opts["-o"]
            with open(out, "wb") as f:
                f.write(png)
        else:
            # 預設檔名：時間＋亂數，用 O_EXCL｜O_NOFOLLOW 新建：同一秒連截兩張不會互蓋，共用的暫存資料夾裡被人預先放同名連結也不會寫到別的檔案
            out = os.path.join(tempfile.gettempdir(), f"codenv-browser-{time.strftime('%Y%m%d-%H%M%S')}-{os.urandom(3).hex()}.png")
            fd = os.open(out, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
            with os.fdopen(fd, "wb") as f:
                f.write(png)
        print(out)
    elif cmd == "export":
        r = ask({"cmd": "export", "pane": pane, "out": os.path.abspath(os.path.expanduser(opts["--out"])) if opts.get("--out") else ""}, timeout=300)
        print(r["folder"])
        line = "%d 輪，%d 張圖" % (r["turns"], r["images"])
        if r.get("failed"):
            line += "；%d 張沒抓到（chat.md 裡留原網址）" % len(r["failed"])
        if r.get("emptyUsers"):
            line += "；有 %d 輪使用者的內容沒抓到（文字和圖片都是空的），看資料夾裡的 diag.json" % r["emptyUsers"]
        print(line)
    else:
        die(f"不認得「{cmd}」：只有 ls、url、text、shot、export（codenv-browser help 看說明）")


if __name__ == "__main__":
    main(sys.argv[1:])
