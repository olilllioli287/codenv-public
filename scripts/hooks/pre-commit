#!/bin/bash
# Bash 3.2 compatible staged-content checks.
set -u

ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
cd "$ROOT" || exit 1

large_allow="$ROOT/scripts/hooks/allow-large.txt"
secret_allow="$ROOT/scripts/hooks/allow-secrets.txt"
errors=0

is_allowed_file() {
    file=$1
    list=$2
    [ -f "$list" ] || return 1
    while IFS= read -r allowed || [ -n "$allowed" ]; do
        case "$allowed" in ''|'#'*) continue ;; esac
        [ "$allowed" = "$file" ] && return 0
    done < "$list"
    return 1
}

report() {
    printf 'pre-commit: %s\n  規則：%s\n  建議：%s\n' "$1" "$2" "$3" >&2
    errors=1
}

# NUL delimiters preserve unusual filenames; process substitution is supported by Bash 3.2.
while IFS= read -r -d '' file; do
    case "$file" in
        *.app/*|.codex-tmp/*|*/.codex-tmp/*|.build/*|*/.build/*|DerivedData/*|*/DerivedData/*|*.dSYM/*|*/.dSYM/*|.DS_Store|*/.DS_Store|*.log)
            report "$file" "禁止提交暫存或建置產物路徑" "使用 git rm --cached '$file'，或解除此檔案的暫存。"
            ;;
    esac

    if ! is_allowed_file "$file" "$large_allow"; then
        object=$(git rev-parse ":$file" 2>/dev/null) || object=
        if [ -n "$object" ]; then
            size=$(git cat-file -s "$object" 2>/dev/null) || size=0
            case "$size" in ''|*[!0-9]*) size=0 ;; esac
            if [ "$size" -gt 2097152 ]; then
                report "$file" "檔案大小超過 2 MiB（$size bytes）" "若確為必要 fixture，將 '$file' 加入 scripts/hooks/allow-large.txt；否則解除暫存。"
            fi
        fi
    fi
done < <(git diff --cached --name-only --diff-filter=ACM -z)

while IFS= read -r -d '' file; do
    if git diff --cached -U0 -- "$file" | awk '/^\+\+\+/ {next} /^\+/ && ($0 ~ /(^|[^[:alnum:]_])\/tmp(\/|$)/ || $0 ~ /(^|[^[:alnum:]_])\/private\/tmp(\/|$)/) {found=1} END {exit !found}'; then
        report "$file" "新增行包含 /tmp 或 /private/tmp 絕對路徑" "移除或改用 repo 相對路徑，然後重新暫存。"
    fi
done < <(git diff --cached --name-only --diff-filter=ACM -z)

if command -v gitleaks >/dev/null 2>&1; then
    gitleaks_report=$(mktemp "${TMPDIR:-/tmp}/precommit-gitleaks.XXXXXX") || {
        report "暫存差異" "無法建立 gitleaks 報告" "確認暫存目錄可寫入後重試。"
        exit "$errors"
    }
    if gitleaks protect --staged --redact --report-format json --report-path "$gitleaks_report"; then
        :
    else
        gitleaks_status=$?
        if [ ! -s "$gitleaks_report" ]; then
            report "暫存差異" "gitleaks 掃描失敗（exit $gitleaks_status）" "確認 gitleaks 設定與版本正常，再重試。"
        else
            if ! command -v python3 >/dev/null 2>&1 || ! python3 - "$gitleaks_report" "$secret_allow" <<'PY'
import json
import sys

with open(sys.argv[1], encoding="utf-8") as f:
    findings = json.load(f)
allowed = set()
try:
    with open(sys.argv[2], encoding="utf-8") as f:
        allowed = {line.strip() for line in f if line.strip() and not line.lstrip().startswith("#")}
except FileNotFoundError:
    pass
for finding in findings:
    path = finding.get("File") or finding.get("file")
    if not path or path not in allowed:
        sys.exit(1)
PY
            then
                report "暫存差異" "gitleaks 偵測到疑似金鑰" "移除該憑證並輪替；測試假金鑰檔可列入 scripts/hooks/allow-secrets.txt。"
            fi
        fi
    fi
    rm -f "$gitleaks_report"
else
    while IFS= read -r -d '' file; do
        is_allowed_file "$file" "$secret_allow" && continue
        if git diff --cached -U0 -- "$file" | awk '
            /^\+\+\+/ {next}
            /^\+/ && /# gitleaks:allow/ {next}
            /^\+/ && ($0 ~ /AIza/ || $0 ~ /AQ\./ || $0 ~ /sk-/ || $0 ~ /ghp_/ || $0 ~ /github_pat_/ || $0 ~ /KGAT/ || $0 ~ /nvapi-/ || $0 ~ /sk-or-/ || $0 ~ /xox[bp]-/ || $0 ~ /(KEY|TOKEN|SECRET)=[A-Za-z0-9_-]{16,}/) {found=1; exit}
            END { if (!found) exit 1 }
        '; then
            report "$file" "新增行符合內建疑似金鑰特徵" "移除並輪替真實憑證；確認是假資料時加 # gitleaks:allow 或列入 scripts/hooks/allow-secrets.txt。"
        fi
    done < <(git diff --cached --name-only --diff-filter=ACM -z)
fi

exit "$errors"
